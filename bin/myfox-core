#!/usr/bin/env bash
# myfox-core — диспетчер install/update/uninstall. Внутренний интерфейс:
# вызывается только программно, из get.sh (bootstrap) или из установленного
# ~/.local/bin/myfox (сам он — копия get.sh, см. bin/myfox-launcher). Наружу
# как публичная команда не торчит.
#
# Usage: myfox-core <install|update|uninstall> [options]
set -eo pipefail

MYFOX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# ─── Сабкоманда + флаги ──────────────────────────────────────────────────────

SUB="install"
case "${1:-}" in
    install|update|uninstall) SUB="$1"; shift ;;
esac

PREFIX="" PROFILE_ARG="" LANG_ARG="" LIST_LANGUAGES=""
MODE="" NOBL=false NOADDONS=false PLASMA_FORCE=false NO_PLASMA=false FORCE=false SHOW_HELP=""
PLASMA_PKG_HINT="" MYFOX_PATH_HINT=""
MYFOX_NONINTERACTIVE="${MYFOX_NONINTERACTIVE:-}"
MYFOX_VERBOSE="${MYFOX_VERBOSE:-0}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --prefix)   PREFIX="$2"; shift 2 ;;
        --reinstall|--browser-only)
            [[ -n "$MODE" ]] && { echo "Modes --reinstall / --browser-only are mutually exclusive." >&2; exit 1; }
            MODE="${1#--}"; shift ;;
        --profile)  PROFILE_ARG="$2"; shift 2 ;;
        --lang)     LANG_ARG="$2"; shift 2 ;;
        --list-languages) LIST_LANGUAGES=1; shift ;;
        --nobl)     NOBL=true; shift ;;
        --noaddons) NOADDONS=true; shift ;;
        --plasma-integration) PLASMA_FORCE=true; shift ;;
        --noplasma) NO_PLASMA=true; shift ;;
        --force)    FORCE=true; shift ;;
        -y|--yes)   MYFOX_NONINTERACTIVE=1; shift ;;
        -v|--verbose) MYFOX_VERBOSE=1; shift ;;
        -h|--help)  SHOW_HELP=1; shift ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# shellcheck source=lib/common.sh
. "$MYFOX_ROOT/lib/common.sh"

# ─── i18n: --lang → сохранённый opt_lang → $LANG окружения → en ────────────

# shellcheck source=lib/i18n.sh
. "$MYFOX_ROOT/lib/i18n.sh"
i18n_load "${LANG_ARG:-$(state_get opt_lang)}"

usage() {
    cat <<EOF
$(t usage_title)

$(t usage_usage) $0 <install|update|uninstall> [options]

$(t usage_options)
  --prefix <path>    $(t usage_prefix)
  --profile <path>   $(t usage_profile)
  --lang <code>       $(t usage_lang)
  --list-languages    $(t usage_list_languages)
  --reinstall          $(t usage_reinstall)
  --browser-only       $(t usage_browser_only)
  --nobl               $(t usage_nobl)
  --noaddons           $(t usage_noaddons)
  --plasma-integration $(t usage_plasma_integration)
  --noplasma           $(t usage_noplasma)
  --force              $(t usage_force)
  -y, --yes            $(t usage_yes)
  -v, --verbose        $(t usage_verbose)
  -h, --help           $(t usage_help)
EOF
}

[[ -n "$SHOW_HELP" ]] && { usage; exit 0; }

check_deps

# shellcheck source=lib/tui.sh
. "$MYFOX_ROOT/lib/tui.sh"
# shellcheck source=lib/firefox.sh
. "$MYFOX_ROOT/lib/firefox.sh"
# shellcheck source=lib/profile.sh
. "$MYFOX_ROOT/lib/profile.sh"
# shellcheck source=lib/apply.sh
. "$MYFOX_ROOT/lib/apply.sh"
# shellcheck source=lib/addons.sh
. "$MYFOX_ROOT/lib/addons.sh"

if [[ -n "$LIST_LANGUAGES" ]]; then
    firefox_list_languages
    exit 0
fi
if [[ -n "$LANG_ARG" ]] && ! firefox_validate_lang "$LANG_ARG"; then
    error "$(t err_unknown_lang "$LANG_ARG")"
fi
if [[ "$SUB" == "update" && ( -n "$LANG_ARG" || -n "$PROFILE_ARG" ) ]]; then
    error "$(t err_update_incompatible_flags)"
fi

if [[ -n "$PREFIX" ]]; then
    INSTALL_DIR="$PREFIX"
elif saved=$(state_get install_dir); [[ -n "$saved" ]]; then
    INSTALL_DIR="$saved"
else
    INSTALL_DIR="$MYFOX_DEFAULT_PREFIX"
fi

# ─── Общие шаги ──────────────────────────────────────────────────────────────

resolve_lang() {
    local saved
    saved=$(opts_get lang)
    if [[ -n "$LANG_ARG" ]]; then
        LANG_CODE="$LANG_ARG"
    elif [[ -n "$saved" || -n "$MYFOX_NONINTERACTIVE" ]]; then
        LANG_CODE="${saved:-$(firefox_detect_lang)}"
    else
        LANG_CODE=$(firefox_interactive_lang) || { echo "$(t cancelled)" >&2; exit 0; }
    fi
}

resolve_channel() {
    local saved
    saved=$(opts_get channel)
    if [[ -n "$saved" ]]; then
        CHANNEL="$saved"
    elif [[ -n "$MYFOX_NONINTERACTIVE" || ! -t 0 ]]; then
        CHANNEL=stable
    else
        CHANNEL=$(tui_choose_kv "$(t channel_pick_header)" "stable" 0 1 \
            stable "$(t channel_stable)" beta "$(t channel_beta)") || CHANNEL=stable
    fi
}

# Интерактивный мастер первой установки:
#   приветствие → путь → канал (stable/beta) → язык → профиль (пропускается,
#   если своих myfox-профилей нет) → твики или нет (твики=да включают и
#   стили под букмарклеты — отдельно не спрашиваем) → конец (дальше
#   run_install качает и ставит с прогрессом).
# «Назад» — rc 3 от tui_choose_kv/tui_filter_kv, см. lib/tui.sh. Использует
# firefox_interactive_lang/profile_pick_myfox напрямую (не resolve_lang/
# profile_resolve — тем шаги друг о друге ничего не знают и назад вернуть
# не могут). Результат в LANG_CODE, CHANNEL, TWEAKED_PROFILE, BL_ON,
# WIZ_PROFILE(_NEW). rc 1 — отмена (Ctrl-C/Esc на любом шаге).
install_wizard() {
    local step="welcome" rc=0
    LANG_CODE="" CHANNEL="" BL_ON=false TWEAKED_PROFILE=true
    WIZ_PROFILE="" WIZ_PROFILE_NEW=0
    # Some steps are a no-op passthrough under certain conditions (e.g. "no
    # myfox profiles yet" on the profile step) and jump straight to the next
    # step without showing a dialog. That's correct when arriving from
    # further back in the wizard, but wrong when arriving via "Back" from
    # further ahead — it would just bounce right back forward, making the
    # Back button look broken. GOING_BACK lets those passthroughs jump
    # backward instead when that's the direction we're actually navigating.
    local GOING_BACK=0

    while true; do
        case "$step" in
            welcome)
                rc=0
                local welcome_prompt welcome_h=""
                if tui_logo_fits; then
                    welcome_prompt="$(tui_print_logo)"$'\n\n'"$(t wizard_welcome_text)"
                    # Лого статичное (assets/logo.txt); высота подобрана
                    # визуально, не вычисляется (см. scratch/test-welcome.sh,
                    # MYFOX_WELCOME_HEIGHT).
                    welcome_h="${MYFOX_WELCOME_HEIGHT:-32}"
                else
                    welcome_prompt="$(t wizard_welcome_text)"
                fi
                tui_confirm "$welcome_prompt" yes 0 \
                    "$(t wizard_continue_label)" "$(t opt_cancel)" "$welcome_h" || rc=$?
                [[ "$rc" -eq 0 ]] && step="dir_choice" || return 1
                ;;
            dir_choice)
                if [[ -n "$PREFIX" ]]; then
                    step="channel"
                    continue
                fi
                rc=0
                local dchoice keep_label
                if [[ "$INSTALL_DIR" == "$MYFOX_DEFAULT_PREFIX" ]]; then
                    keep_label="$(t installdir_default_option "$MYFOX_DEFAULT_PREFIX")"
                else
                    keep_label="$INSTALL_DIR"
                fi
                dchoice=$(tui_choose_kv "$(t installdir_pick_header)" "keep" 0 1 \
                    keep "$keep_label" \
                    custom "$(t installdir_custom_option)") || rc=$?
                [[ "$rc" -ne 0 ]] && return 1
                if [[ "$dchoice" == "custom" ]]; then
                    # Ввод пути с проверкой: при ошибке — сообщение и снова
                    # ввод; отмена/успех — назад на этот же экран (он покажет
                    # актуальный путь), а не молча дальше.
                    local typed="$INSTALL_DIR" verdict
                    while typed=$(tui_pick_dir "$typed"); do
                        if verdict=$(install_dir_validate "$typed"); then
                            INSTALL_DIR="$verdict"
                            break
                        fi
                        tui_msgbox "$verdict"
                    done
                else
                    step="channel"
                fi
                ;;
            channel)
                rc=0
                local ans
                # «Назад» — только если экран выбора пути вообще показывался.
                local channel_back=1
                [[ -n "$PREFIX" ]] && channel_back=0
                ans=$(tui_choose_kv "$(t channel_pick_header)" "stable" "$channel_back" 1 \
                    stable "$(t channel_stable)" beta "$(t channel_beta)") || rc=$?
                if [[ "$rc" -eq 3 ]]; then
                    step="dir_choice"
                elif [[ "$rc" -ne 0 ]]; then
                    return 1
                else
                    CHANNEL="$ans"
                    step="lang"
                fi
                ;;
            lang)
                if [[ -n "$LANG_ARG" ]]; then
                    LANG_CODE="$LANG_ARG"
                    step="profile"
                    continue
                fi
                # Fetched (and cached in MYFOX_LANG_LIST) only once, right
                # here — after the user has actually confirmed through
                # welcome/dir/channel, not before they've even said
                # "Continue", and inside the wizard's own already-open
                # alt-screen fence (tui_session_begin already ran), so a
                # plain --infobox is enough: it draws straight into the
                # same fenced screen, no separate fence of its own needed,
                # and stays up for as long as the curl call blocks instead
                # of leaving a blank screen.
                if [[ ! -s "${MYFOX_LANG_LIST:-}" ]]; then
                    local lang_fetch_backend
                    lang_fetch_backend=$(tui_backend)
                    if [[ "$lang_fetch_backend" == "dialog" ]]; then
                        dialog --infobox "$(t fetching_lang_list)" 5 "$(_tui_box_width)"
                    elif [[ "$lang_fetch_backend" == "whiptail" ]]; then
                        whiptail --infobox "$(t fetching_lang_list)" 5 "$(_tui_box_width)"
                    fi
                    firefox_prepare_lang_list || true
                fi
                rc=0
                LANG_CODE=$(firefox_interactive_lang 1) || rc=$?
                if [[ "$rc" -eq 3 ]]; then
                    step="channel"
                elif [[ "$rc" -ne 0 ]]; then
                    return 1
                else
                    GOING_BACK=0
                    step="profile"
                fi
                ;;
            profile)
                if [[ -n "$PROFILE_ARG" ]]; then
                    step="tweaks"
                    continue
                fi
                local myfox_list
                myfox_list=$(profile_list_myfox || true)
                if [[ -z "$myfox_list" ]]; then
                    WIZ_PROFILE_NEW=1; WIZ_PROFILE=""
                    if [[ "$GOING_BACK" == 1 ]]; then
                        step="lang"
                    else
                        step="tweaks"
                    fi
                    continue
                fi
                rc=0
                local chosen
                chosen=$(profile_pick_myfox "$myfox_list" 1) || rc=$?
                if [[ "$rc" -eq 3 ]]; then
                    step="lang"
                elif [[ "$rc" -ne 0 ]]; then
                    return 1
                elif [[ -z "$chosen" ]]; then
                    WIZ_PROFILE_NEW=1; WIZ_PROFILE=""
                    step="tweaks"
                else
                    WIZ_PROFILE_NEW=0; WIZ_PROFILE="$chosen"
                    step="tweaks"
                fi
                ;;
            tweaks)
                rc=0
                local ans
                ans=$(tui_choose_kv "$(t confirm_tweaks)" "yes" 1 1 \
                    yes "$(t opt_yes)" no "$(t opt_no)") || rc=$?
                if [[ "$rc" -eq 3 ]]; then
                    GOING_BACK=1
                    step="profile"
                elif [[ "$rc" -ne 0 ]]; then
                    return 1
                elif [[ "$ans" == "yes" ]]; then
                    # Твики включают и стили под букмарклеты — отдельно не спрашиваем.
                    TWEAKED_PROFILE=true
                    BL_ON=true
                    step="summary"
                else
                    TWEAKED_PROFILE=false
                    BL_ON=false
                    step="summary"
                fi
                ;;
            summary)
                rc=0
                tui_confirm "$(_wizard_summary_text)" yes 1 \
                    "$(t summary_install_label)" "$(t opt_cancel)" || rc=$?
                if [[ "$rc" -eq 3 ]]; then
                    step="tweaks"
                elif [[ "$rc" -ne 0 ]]; then
                    return 1
                else
                    return 0
                fi
                ;;
        esac
    done
}

# Текст сводного экрана мастера: что именно будет установлено с учётом уже
# сделанных выборов (путь/канал/язык/профиль/твики/букмарклеты/аддоны —
# аддоны включаются молча вместе с твиками, поэтому тут единственное место,
# где пользователь вообще о них узнаёт).
_wizard_summary_text() {
    local profile_desc channel_desc
    if [[ "$WIZ_PROFILE_NEW" == "1" || -z "$WIZ_PROFILE" ]]; then
        profile_desc="$(t profile_new_option)"
    else
        profile_desc="$(myfox_shorten_home "$WIZ_PROFILE")"
    fi
    if [[ "$CHANNEL" == "beta" ]]; then channel_desc="$(t channel_beta)"; else channel_desc="$(t channel_stable)"; fi

    local -a lines=(
        "$(t summary_header)"
        ""
        "$(t summary_row_path "$INSTALL_DIR")"
        "$(t summary_row_channel "$channel_desc")"
        "$(t summary_row_lang "$LANG_CODE")"
        "$(t summary_row_profile "$profile_desc")"
    )
    if [[ "$TWEAKED_PROFILE" == "true" ]]; then
        lines+=("$(t summary_row_tweaks_yes)" "$(t summary_row_bl)" "$(t summary_row_addons)")
    else
        lines+=("$(t summary_row_tweaks_no)")
    fi
    lines+=("" "$(t summary_confirm_prompt)")

    local IFS=$'\n'
    printf '%s' "${lines[*]}"
}

fetch_tarball_version() {
    local rc=0
    FIREFOX_VERSION=$(firefox_install_tarball "$INSTALL_DIR" "$LANG_CODE" "$CHANNEL") || rc=$?
    if [[ "$rc" -eq 2 ]]; then
        exit 0
    elif [[ "$rc" -ne 0 ]]; then
        exit "$rc"
    fi
}

# Устанавливает/переиспользует браузер из тарбола. <first|reinstall>
install_browser_tarball() {
    local mode="$1"
    FIREFOX_VERSION=""
    local claim
    claim=$(firefox_dir_claim_state "$INSTALL_DIR")

    if [[ "$mode" != "reinstall" && "$claim" == "ours" ]]; then
        log "$(t firefox_already_installed "$INSTALL_DIR")"
        FIREFOX_VERSION=$(firefox_local_version "$INSTALL_DIR")
    else
        if [[ "$claim" == "foreign" || ( "$mode" == "reinstall" && "$claim" != "empty" ) ]]; then
            [[ "$claim" == "foreign" ]] && warn "$(t warn_dir_occupied "$INSTALL_DIR")"
            log "$(t reinstalling_cleanly)"
            find "$INSTALL_DIR" -mindepth 1 -delete 2>/dev/null || true
        fi
        fetch_tarball_version
    fi

    touch "$INSTALL_DIR/.myfox-installed"
    [[ -n "$FIREFOX_VERSION" ]] && state_set firefox_version "$FIREFOX_VERSION"
}

# Копирует лаунчер (~/.local/bin/myfox): из тарбола (bin/myfox-launcher) если
# есть, иначе — сам get.sh из корня репозитория (git-clone / make install).
install_launcher() {
    mkdir -p "$MYFOX_BIN_DIR"
    if [[ -f "$MYFOX_ROOT/bin/myfox-launcher" ]]; then
        install -m 0755 "$MYFOX_ROOT/bin/myfox-launcher" "$MYFOX_LAUNCHER_PATH"
    else
        install -m 0755 "$MYFOX_ROOT/get.sh" "$MYFOX_LAUNCHER_PATH"
    fi

    # Постоянная копия core — myfox uninstall работает из неё офлайн, без
    # повторного скачивания тарбола (только myfox update качает заново).
    rm -rf "$MYFOX_CORE_DIR"
    mkdir -p "$MYFOX_CORE_DIR/bin"
    install -m 0755 "$MYFOX_ROOT/bin/myfox-core" "$MYFOX_CORE_DIR/bin/myfox-core"
    cp -a "$MYFOX_ROOT/lib" "$MYFOX_CORE_DIR/lib"
    cp -a "$MYFOX_ROOT/i18n" "$MYFOX_CORE_DIR/i18n"

    success "$(t launcher_installed "$MYFOX_LAUNCHER_PATH")"
    case ":$PATH:" in
        *":$MYFOX_BIN_DIR:"*) ;;
        *) MYFOX_PATH_HINT=1 ;;
    esac
}

# resolve_bookmarklets — только вопрос/решение (устанавливает глобальный
# BL_APPLY). Сама установка файлов выполняется позже, вместе с пиннингом
# профиля и аддонами, под одним общим спиннером "Настройка профиля" —
# отдельная строка с внутренним термином "букмарклеты" конечному
# пользователю ничего не даёт.
resolve_bookmarklets() {
    BL_APPLY=0
    if [[ "$NOBL" == true ]]; then
        opts_set bl false
        log "$(t bl_skipped_flag)"
        return 0
    fi
    if [[ -n "$WIZARD_RAN" ]]; then
        if [[ "$BL_ON" == true ]]; then
            opts_set bl true
        else
            opts_set bl false
            log "$(t bl_skipped)"
            return 0
        fi
    elif opts_has bl; then
        if [[ "$(opts_get bl)" != "true" ]]; then
            opts_set bl false
            log "$(t bl_skipped_saved)"
            return 0
        fi
    elif ! tui_confirm "$(t confirm_bookmarklets)" yes; then
        opts_set bl false
        log "$(t bl_skipped)"
        return 0
    fi
    opts_set bl true
    BL_APPLY=1
}

maybe_add_plasma() {  # <array-name>
    local -n arr="$1"
    arr+=("$MYFOX_ADDON_PLASMA")
    if addons_pkg_installed; then
        log "$(t plasma_pkg_present)"
        return 0
    fi
    warn "$(t warn_plasma_pkg_missing)"
    PLASMA_PKG_HINT=$(addons_pkg_suggest) || true
    if [[ -z "$PLASMA_PKG_HINT" ]]; then
        log "$(t plasma_pkg_manual)"
    else
        log "$(t plasma_pkg_hint "$PLASMA_PKG_HINT")"
    fi
}

# resolve_addons — интерактивные вопросы (confirm, детект Plasma) и наполнение
# глобального ADDONS_LIST. Без tui_spin: сама загрузка аддонов выполняется
# позже, вместе с пиннингом профиля, под одним общим спиннером — пользователю
# всё равно, что это технически два разных шага.
resolve_addons() {
    ADDONS_LIST=()

    if [[ "$NOADDONS" == true ]]; then
        opts_set addons false
        log "$(t addons_skipped_flag)"
        return 0
    fi
    if [[ -n "$WIZARD_RAN" ]]; then
        opts_set addons true
    elif opts_has addons; then
        if [[ "$(opts_get addons)" != "true" ]]; then
            opts_set addons false
            log "$(t addons_skipped_saved)"
            return 0
        fi
    elif ! tui_confirm "$(t confirm_addons)" yes; then
        opts_set addons false
        log "$(t addons_skipped)"
        return 0
    fi
    opts_set addons true
    ADDONS_LIST+=("$MYFOX_ADDON_UBLOCK" "$MYFOX_ADDON_THEME")

    local plasma_opt
    plasma_opt=$(opts_get plasma)
    if [[ "$NO_PLASMA" == true ]]; then
        opts_set plasma false
        log "$(t plasma_skipped_flag)"
    elif [[ "$PLASMA_FORCE" == true ]]; then
        opts_set plasma true
        maybe_add_plasma ADDONS_LIST
    elif [[ -n "$plasma_opt" ]]; then
        if [[ "$plasma_opt" == "true" ]]; then
            log "$(t plasma_enabled_saved)"
            maybe_add_plasma ADDONS_LIST
        else
            log "$(t plasma_skipped_saved)"
        fi
    elif addons_is_plasma; then
        opts_set plasma true
        log "$(t plasma_enabled_session)"
        maybe_add_plasma ADDONS_LIST
    else
        opts_set plasma false
        log "$(t plasma_skipped_not_session)"
    fi
    return 0
}

# _setup_profile — тело общего спиннера "Настройка профиля": headless-пиннинг
# инсталла, autoconfig/chrome, аддоны и букмарклеты — всё, что технически
# отдельные шаги, но для пользователя один этап установки.
_setup_profile() {  # <install_dir> <profile_dir> [addon-slug...]
    local install_dir="$1" profile_dir="$2"; shift 2
    profile_pin_install "$install_dir" "$profile_dir"
    local rc=$?
    apply_autoconfig "$install_dir"
    apply_chrome "$profile_dir"
    [[ $# -gt 0 ]] && addons_apply "$profile_dir" "$@"
    [[ "$BL_APPLY" == 1 ]] && apply_bookmarklets "$profile_dir" >/dev/null
    return "$rc"
}

# _update_tweaks — тело общего спиннера "Настройка профиля" в `myfox update`.
_update_tweaks() {  # <install_dir> <profile_dir> <bl_apply:0|1>
    local install_dir="$1" profile_dir="$2" bl_apply="$3"
    apply_autoconfig "$install_dir"
    apply_chrome "$profile_dir"
    [[ "$bl_apply" == 1 ]] && apply_bookmarklets "$profile_dir" >/dev/null
    return 0
}

print_summary() {
    echo ""
    tui_style "$(t summary_title)"
    echo "  $(t summary_firefox "${INSTALL_DIR:-?}" "${FIREFOX_VERSION:-latest}" "${LANG_CODE:-auto}")"
    [[ -n "${PROFILE_DIR:-}" ]] && echo "  $(t summary_profile "$PROFILE_DIR")"
    echo "  $(t summary_desktop)"
    echo ""
    echo "$(t summary_run_hint)"
    echo ""
    echo "$(t summary_update_hint)"
    echo "$(t summary_uninstall_hint)"
    if [[ -n "$MYFOX_PATH_HINT" ]]; then
        echo ""
        warn "$(t warn_path_hint "$MYFOX_BIN_DIR")"
    fi
    if [[ -n "$PLASMA_PKG_HINT" ]]; then
        echo ""
        echo -e "${BOLD}$(t plasma_summary_title)${NC}"
        echo "  ${PLASMA_PKG_HINT}"
    fi
}

# ─── install ─────────────────────────────────────────────────────────────────

run_browser_only() {
    resolve_lang
    resolve_channel
    if [[ "$MODE" == "reinstall" ]]; then
        install_browser_tarball reinstall
    else
        install_browser_tarball first
    fi
    state_set install_dir "$INSTALL_DIR"
    state_set installed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    opts_set browser_only true
    opts_set lang "$LANG_CODE"
    firefox_create_desktop_entry "$INSTALL_DIR" "$MYFOX_DESKTOP_TITLE" "$MYFOX_DESKTOP_NAME"
    install_launcher
    success "$(t browser_only_installed)"
    print_summary
}

run_install() {
    if has_marker && [[ "$FORCE" != true ]]; then
        if [[ -n "$MYFOX_NONINTERACTIVE" ]]; then
            error "$(t err_already_installed_use_force)"
        elif ! tui_confirm "$(t confirm_reinstall_over_existing "$(state_get install_dir)")" no; then
            echo "$(t cancelled)" >&2
            exit 0
        fi
    fi

    tui_style "$(t welcome_banner "$INSTALL_DIR")"

    if [[ "$MODE" == "browser-only" ]]; then
        run_browser_only
        return 0
    fi

    WIZARD_RAN=""
    TWEAKED_PROFILE=true
    if [[ -z "$MYFOX_NONINTERACTIVE" && -t 0 ]]; then
        trap 'tui_session_end' EXIT
        tui_session_begin
        local wizard_rc=0
        install_wizard || wizard_rc=$?
        tui_session_end
        trap - EXIT
        [[ "$wizard_rc" -ne 0 ]] && { echo "$(t cancelled)" >&2; exit 0; }
        WIZARD_RAN=1
        # Мастер уже спросил "Продолжить?" на приветствии — второй раз перед
        # скачиванием (внутри firefox_install_tarball) не спрашиваем.
        MYFOX_SKIP_CONFIRM=1
    else
        resolve_lang
        resolve_channel
    fi

    if [[ "$MODE" == "reinstall" ]]; then
        install_browser_tarball reinstall
    else
        install_browser_tarball first
    fi

    state_set install_dir "$INSTALL_DIR"
    state_set installed_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    opts_set browser_only false
    opts_set lang "$LANG_CODE"
    opts_set channel "$CHANNEL"

    if [[ "$WIZARD_RAN" == "1" && "$WIZ_PROFILE_NEW" == "1" ]]; then
        PROFILE_DIR=$(MYFOX_PROFILE_FORCE_NEW=1 profile_resolve --explicit "$PROFILE_ARG")
    elif [[ "$WIZARD_RAN" == "1" && -n "$WIZ_PROFILE" ]]; then
        PROFILE_DIR=$(profile_resolve --explicit "$WIZ_PROFILE")
        log "$(t profile_using_saved "$WIZ_PROFILE")"
    else
        PROFILE_DIR=$(profile_resolve --explicit "$PROFILE_ARG")
    fi
    state_set profile_dir "$PROFILE_DIR"
    log "$(t using_profile "$PROFILE_DIR")"

    if [[ "$TWEAKED_PROFILE" == "false" ]]; then
        # Чистый профиль (выбор мастера "твики: нет") — твики/букмарклеты/
        # аддоны/пиннинг не трогаем, только браузер + ярлык.
        log "$(t clean_profile_skip)"
        firefox_create_desktop_entry "$INSTALL_DIR" "$MYFOX_DESKTOP_TITLE" "$MYFOX_DESKTOP_NAME"
        opts_set bl false
        opts_set addons false
        install_launcher
        print_summary
        return 0
    fi

    local -a ADDONS_LIST=()
    local BL_APPLY=0
    resolve_addons
    resolve_bookmarklets

    local pin_hash
    pin_hash=$(tui_spin "$(t pinning_profile)" -- _setup_profile "$INSTALL_DIR" "$PROFILE_DIR" "${ADDONS_LIST[@]}") || true
    [[ -n "$pin_hash" ]] && state_set install_hash "$pin_hash"

    firefox_create_desktop_entry "$INSTALL_DIR" "$MYFOX_DESKTOP_TITLE" "$MYFOX_DESKTOP_NAME"
    install_launcher

    print_summary
}

# ─── update ──────────────────────────────────────────────────────────────────

run_update() {
    INSTALL_DIR=$(state_get install_dir)
    PROFILE_DIR=$(state_get profile_dir)
    [[ -z "$INSTALL_DIR" ]] && error "$(t err_no_saved_install)"
    FIREFOX_VERSION=$(state_get firefox_version)
    LANG_CODE=$(opts_get lang)

    if [[ "$MODE" == "reinstall" ]]; then
        resolve_lang
        resolve_channel
        install_browser_tarball reinstall
    elif [[ ! -f "$INSTALL_DIR/application.ini" ]]; then
        error "$(t err_firefox_missing_reinstall)"
    fi

    if [[ -n "$PROFILE_DIR" ]]; then
        [[ -d "$PROFILE_DIR" ]] || error "$(t err_profile_not_found_state "$PROFILE_DIR")"
        local bl_apply=0
        [[ "$(opts_get bl)" == "true" ]] && bl_apply=1
        tui_spin "$(t pinning_profile)" -- _update_tweaks "$INSTALL_DIR" "$PROFILE_DIR" "$bl_apply"
    else
        firefox_create_desktop_entry "$INSTALL_DIR" "$MYFOX_DESKTOP_TITLE" "$MYFOX_DESKTOP_NAME"
    fi

    install_launcher
    success "$(t tweaks_updated)"
    print_summary
}

# ─── uninstall ───────────────────────────────────────────────────────────────

# Prints PIDs of the *parent* firefox process(es) running from install_dir
# (never the -contentproc children — killing those directly instead of the
# parent just makes Firefox respawn them).
_uninstall_running_pids() {  # <install_dir>
    local install_dir="$1" bin
    for bin in "$install_dir/firefox-bin" "$install_dir/firefox"; do
        [[ -x "$bin" ]] || continue
        local pid cmd
        for pid in $(pgrep -f "$bin" 2>/dev/null || true); do
            cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || continue
            [[ "$cmd" == "$bin "* || "$cmd" == "$bin" ]] || continue
            [[ "$cmd" == *-contentproc* ]] && continue
            echo "$pid"
        done
        return 0
    done
}

# Removing profile/chrome files or unpinning the install while our own
# Firefox is still running is unsafe: it holds prefs.js/sessionstore open
# and can write them back after we've already deleted things underneath it.
# Ask to close it (graceful SIGTERM, escalating to SIGKILL only if it
# ignores that for 10s) before touching anything.
_uninstall_stop_running() {  # <install_dir>
    local install_dir="$1"
    local pids
    pids=$(_uninstall_running_pids "$install_dir")
    [[ -z "$pids" ]] && return 0

    if [[ -z "$MYFOX_NONINTERACTIVE" ]]; then
        tui_session_begin
        local proceed=yes
        tui_confirm "$(t confirm_close_running)" yes || proceed=no
        tui_session_end
        if [[ "$proceed" == "no" ]]; then
            warn "$(t warn_still_running)"
            return 1
        fi
    else
        warn "$(t closing_running_ff)"
    fi

    local pid
    for pid in $pids; do kill "$pid" 2>/dev/null || true; done

    local waited=0
    while [[ $waited -lt 10 ]]; do
        pids=$(_uninstall_running_pids "$install_dir")
        [[ -z "$pids" ]] && return 0
        sleep 1
        waited=$((waited + 1))
    done

    warn "$(t warn_force_kill)"
    for pid in $pids; do kill -9 "$pid" 2>/dev/null || true; done
    sleep 1
    return 0
}

# Мастер деинсталляции: удалить Firefox? → (если есть профиль) удалить
# профиль? → сводка, где принимается окончательное решение. «Нет» на первом
# вопросе — сразу конец. Результат — UNINST_DEL_PROFILE (yes|no); rc 1 — отмена.
_uninstall_wizard() {  # <profile_type: created|existing|"">
    local profile_type="$1" step="app" rc
    UNINST_DEL_PROFILE=yes
    while true; do
        case "$step" in
            app)
                tui_confirm "$(t confirm_remove_app "$INSTALL_DIR")" yes || return 1
                if [[ -n "$PROFILE_DIR" ]]; then step="profile"; else step="summary"; fi
                ;;
            profile)
                local q
                [[ "$profile_type" == "existing" ]] && q="$(t confirm_remove_tweaks)" || q="$(t confirm_delete_profile)"
                rc=0
                tui_confirm "$q" no 1 || rc=$?
                case "$rc" in
                    0) UNINST_DEL_PROFILE=yes; step="summary" ;;
                    3) step="app" ;;
                    *) UNINST_DEL_PROFILE=no; step="summary" ;;
                esac
                ;;
            summary)
                rc=0
                tui_confirm "$(_uninstall_summary_text "$profile_type")" yes 1 \
                    "$(t uninstall_summary_label)" "$(t opt_cancel)" || rc=$?
                case "$rc" in
                    0) return 0 ;;
                    3) if [[ -n "$PROFILE_DIR" ]]; then step="profile"; else step="app"; fi ;;
                    *) return 1 ;;
                esac
                ;;
        esac
    done
}

_uninstall_summary_text() {  # <profile_type>
    local profile_type="$1"
    local -a lines=(
        "$(t uninstall_summary_header)"
        ""
        "$(t uninstall_row_app "$(myfox_shorten_home "$INSTALL_DIR")")"
    )
    if [[ -n "$PROFILE_DIR" ]]; then
        local pd; pd="$(myfox_shorten_home "$PROFILE_DIR")"
        if [[ "$UNINST_DEL_PROFILE" != "yes" ]]; then
            lines+=("$(t uninstall_row_profile_keep "$pd")")
        elif [[ "$profile_type" == "existing" ]]; then
            lines+=("$(t uninstall_row_profile_tweaks "$pd")")
        else
            lines+=("$(t uninstall_row_profile_delete "$pd")")
        fi
    fi
    lines+=("" "$(t uninstall_summary_confirm)")
    local IFS=$'\n'
    printf '%s' "${lines[*]}"
}

run_uninstall() {
    # set -e aborts silently on the first failing command otherwise — a
    # clean status line either way (success/cancelled were already covered
    # below; this is specifically the "something broke partway through" case).
    trap 'echo -e "${RED}$(t err_uninstall_failed)${NC}" >&2' ERR

    if [[ ! -f "$MYFOX_STATE_FILE" ]]; then
        warn "$(t warn_no_install_record "$MYFOX_STATE_FILE")"
        warn "$(t warn_manual_removal_hint)"
        exit 0
    fi

    INSTALL_DIR=$(state_get install_dir)
    PROFILE_DIR=$(state_get profile_dir)

    local profile_type=""
    if [[ -n "$PROFILE_DIR" ]]; then
        if [[ -f "$PROFILE_DIR/.myfox-created" ]]; then
            profile_type=created
        elif [[ -d "$PROFILE_DIR" ]]; then
            profile_type=existing
        fi
    fi

    local del_profile=yes
    if [[ -z "$MYFOX_NONINTERACTIVE" ]]; then
        trap 'tui_session_end' EXIT
        tui_session_begin
        local uw_rc=0
        _uninstall_wizard "$profile_type" || uw_rc=$?
        tui_session_end
        trap - EXIT
        if [[ "$uw_rc" -ne 0 ]]; then
            echo "$(t uninstall_cancelled)" >&2
            exit 0
        fi
        del_profile="$UNINST_DEL_PROFILE"
    fi

    if [[ -n "$INSTALL_DIR" ]]; then
        _uninstall_stop_running "$INSTALL_DIR" || {
            echo "$(t uninstall_cancelled)" >&2
            exit 1
        }
    fi

    local install_hash
    install_hash=$(state_get install_hash)
    [[ -n "$install_hash" ]] && profile_unpin_install "$install_hash"

    if [[ -d "$INSTALL_DIR" ]]; then
        rm -f "$INSTALL_DIR/defaults/pref/autoconfig.js" "$INSTALL_DIR/firefox.cfg" \
            "$INSTALL_DIR/.myfox-installed" 2>/dev/null || true
        success "$(t autoconfig_removed "$INSTALL_DIR")"
    fi

    if [[ "$profile_type" == "created" ]]; then
        if [[ "$del_profile" == "yes" ]]; then
            rm -rf "$PROFILE_DIR"
            profile_remove_myfox_section "$PROFILE_DIR"
            success "$(t profile_deleted "$PROFILE_DIR")"
        else
            log "$(t profile_kept "$PROFILE_DIR")"
            profile_remove_myfox_section "$PROFILE_DIR"
        fi
    elif [[ "$profile_type" == "existing" && "$del_profile" == "yes" && -d "$PROFILE_DIR/chrome" ]]; then
        local f
        for f in userChrome.css agent_overrides.css; do
            if [[ -f "$PROFILE_DIR/chrome/$f.myfox-backup" ]]; then
                rm -f "$PROFILE_DIR/chrome/$f"
                mv -f "$PROFILE_DIR/chrome/$f.myfox-backup" "$PROFILE_DIR/chrome/$f"
                success "$(t style_restored "$f")"
            else
                rm -f "$PROFILE_DIR/chrome/$f"
            fi
        done
        rm -f "$PROFILE_DIR/chrome/blm_panel.css" 2>/dev/null || true
        rm -rf "$PROFILE_DIR/chrome/panel-icons" 2>/dev/null || true
        rm -f "$PROFILE_DIR/.myfox" 2>/dev/null || true
        success "$(t chrome_removed "$PROFILE_DIR")"
    fi

    # Аддоны (uBlock/тема/plasma) удаляются только по фиксированным ID —
    # остальные *.xpi в extensions/ могут быть пользовательскими (existing-профиль).
    local -a addon_ids=(
        "uBlock0@raymondhill.net"
        "{9631ec37-35f2-4719-815e-2f84ff28b901}"
        "plasma-browser-integration@kde.org"
    )
    if [[ "$profile_type" == "existing" && "$del_profile" == "yes" \
        && -n "$PROFILE_DIR" && -d "$PROFILE_DIR/extensions" ]]; then
        local id
        for id in "${addon_ids[@]}"; do
            rm -f "$PROFILE_DIR/extensions/$id.xpi" 2>/dev/null || true
            rm -rf "$PROFILE_DIR/extensions/$id" 2>/dev/null || true
        done
        rmdir "$PROFILE_DIR/extensions" 2>/dev/null || true
    fi

    firefox_remove_desktop_entry

    if [[ -d "$INSTALL_DIR" ]]; then
        rm -rf "$INSTALL_DIR"
        success "$(t dir_removed "$INSTALL_DIR")"
    fi

    state_clear
    [[ -f "$MYFOX_LAUNCHER_PATH" ]] && rm -f "$MYFOX_LAUNCHER_PATH"

    echo ""
    if [[ "$del_profile" == "no" && -n "$PROFILE_DIR" ]]; then
        echo -e "${GREEN}$(t app_removed)${NC}"
        echo "  $(t profile_kept_summary "$PROFILE_DIR")"
    else
        success "$(t uninstalled)"
    fi

    # Последним шагом — постоянная копия core (bin/myfox-core+lib/+i18n/,
    # см. install_launcher). Когда офлайн-uninstall запущен ИЗ неё самой
    # (get.sh делегирует сюда напрямую, без сети) — это самоудаление
    # собственного каталога; безопасно на Linux, т.к. bash к этому моменту
    # уже прочитал весь скрипт целиком, дальнейших чтений с диска не будет.
    rm -rf "$MYFOX_CORE_DIR"
}

# ─── Диспетчер ───────────────────────────────────────────────────────────────

case "$SUB" in
    install)   run_install ;;
    update)    run_update ;;
    uninstall) run_uninstall ;;
    *)         error "Unknown subcommand: $SUB" ;;
esac
