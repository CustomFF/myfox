[Desktop Entry]
Actions=new-window;new-tab;new-private-window;preferences;restart;myfox-refresh;
Categories=Network;WebBrowser;
Comment=@T:desktop_comment@
Exec=@WRAPPER@ %u
GenericName=@T:desktop_generic_name@
Icon=@ICON@
Keywords=@T:desktop_keywords@
MimeType=video/webm;text/html;image/png;image/jpeg;image/gif;application/xml;application/xhtml+xml;application/x-xpinstall;application/rss+xml;application/rdf+xml;application/pdf;application/xhtml_xml;image/webp;text/xml;x-scheme-handler/http;x-scheme-handler/https;
Name=@APP_NAME@
NoDisplay=false
StartupNotify=true
StartupWMClass=firefox-myfox
Terminal=false
Type=Application
Version=1.0
X-GNOME-FullName=@APP_NAME@
X-MultipleArgs=false

[Desktop Action new-window]
Exec=@WRAPPER@ --new-window
Icon=window-new-symbolic
Name=@T:desktop_action_new_window@

[Desktop Action new-tab]
Exec=@WRAPPER@ --new-tab about:newtab
Icon=tab-new-symbolic
Name=@T:desktop_action_new_tab@

[Desktop Action new-private-window]
Exec=@WRAPPER@ --private-window
Icon=view-private-symbolic
Name=@T:desktop_action_new_private_window@

[Desktop Action preferences]
Exec=@WRAPPER@ about:preferences
Icon=settings-configure-symbolic
Name=@T:desktop_action_preferences@

[Desktop Action restart]
Exec=@WRAPPER@ --myfox-restart
Icon=view-refresh-symbolic
Name=@T:desktop_action_restart@

[Desktop Action myfox-refresh]
Exec=@LAUNCHER@ refresh --gui
Icon=system-software-update
Name=@T:desktop_action_refresh@
